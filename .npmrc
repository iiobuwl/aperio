# 依存ライブラリのインストールを、安全側にする設定です(OWASP A08: ソフトウェアとデータの完全性)
# インストール時に、ライブラリが勝手にスクリプトを実行するのを止める(サプライチェーン攻撃への対策)
ignore-scripts=true
# 高い深刻度の脆弱性があれば、npm audit が失敗する
audit-level=high
fund=false
# 新しく入れるライブラリは、^ や ~ ではなく、正確なバージョンで固定する
save-exact=true
# package.json の engines(Node のバージョン)に合わない環境では、インストールしない
engine-strict=true
